{
  "manifest_version": 3,
  "name": "Fantasy Draft Companion",
  "version": "0.3.0",
  "description": "A local draft companion with automatic pick sync and opt-in ESPN and Sleeper autodraft control.",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": [
    "https://isaacvazquez.com/*",
    "https://fantasy.espn.com/*",
    "https://sleeper.com/*",
    "https://*.sleeper.com/*",
    "https://api.sleeper.app/*",
    "https://app.underdogsports.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Fantasy Draft Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://sleeper.com/*",
        "https://*.sleeper.com/*",
        "https://app.underdogsports.com/*"
      ],
      "js": ["autodraft-content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
