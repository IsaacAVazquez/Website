{
  "name": "isaac-vazquez-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "update:football": "npm run update:premier-league && sleep 30 && npm run update:la-liga",
    "build": "next build --webpack",
    "build:fantasy-companion": "vite build --config extension/vite.config.ts && node scripts/buildFantasyCompanionExtension.mjs",
    "postbuild": "npm run generate:sitemap && npm run build:llms && node scripts/patch-nft-sharp.mjs",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --pretty false",
    "analyze": "ANALYZE=true npm run build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:full": "E2E_FULL_MATRIX=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "update:premier-league": "tsx --env-file-if-exists=.env.local scripts/buildPremierLeagueSnapshot.ts",
    "update:la-liga": "tsx --env-file-if-exists=.env.local scripts/updateLaLigaSnapshot.ts",
    "update:mlb": "tsx scripts/updateMlbSnapshot.ts",
    "update:nba": "tsx --env-file-if-exists=.env.local scripts/updateNbaSnapshot.ts",
    "update:nfl": "tsx scripts/updateNflSnapshot.ts",
    "update:formula-1": "tsx scripts/buildFormula1Snapshot.ts",
    "update:golf": "tsx scripts/buildGolfSnapshot.ts",
    "update:earthquake": "tsx scripts/buildEarthquakeSnapshot.ts",
    "update:world-cup": "tsx scripts/buildWorldCupSnapshot.ts",
    "update:bay-area-transit": "tsx scripts/buildBayAreaTransitSnapshot.ts",
    "update:frontier-models": "tsx scripts/buildFrontierModelsSnapshot.ts",
    "update:polling": "tsx scripts/buildPollingSnapshot.ts",
    "update:github-trending": "tsx scripts/buildGitHubTrendingSnapshot.ts",
    "update:tech-startups": "tsx scripts/buildTechStartupSnapshot.ts",
    "update:score-pools": "tsx scripts/buildScorePoolsSnapshot.ts",
    "update:spacex": "tsx --env-file-if-exists=.env.local scripts/buildSpaceXSnapshot.ts",
    "update:spacex-images": "tsx --env-file-if-exists=.env.local scripts/buildSpaceXImageSnapshots.ts",
    "update:fantasy": "npm run update:fantasy:redraft && npm run update:fantasy:best-ball && npm run update:fantasy:weekly",
    "update:fantasy:redraft": "tsx scripts/buildFantasyPositionData.ts && tsx scripts/buildFantasyAdpData.ts && tsx scripts/buildFantasyGameLogData.ts && tsx scripts/buildFantasyVorpData.ts && tsx scripts/buildFantasySnapshots.ts",
    "update:fantasy:best-ball": "tsx scripts/buildBestBallSnapshot.ts",
    "update:fantasy:weekly": "tsx scripts/buildFantasyWeeklySnapshot.ts",
    "update:investments": ".venv/bin/python3 scripts/fetch_investments_data.py && tsx scripts/buildInvestmentsSnapshots.ts",
    "update:article-images": "tsx scripts/buildArticleCoverImages.ts",
    "check:blog-dates": "tsx scripts/checkBlogDateReview.ts",
    "generate:sitemap": "node scripts/generatePublicSitemap.mjs",
    "build:llms": "node scripts/buildLlmsFull.mjs",
    "submit:indexnow": "node scripts/submitIndexNow.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.1",
    "cheerio": "^1.2.0",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.7.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@netlify/plugin-nextjs": "^5.15.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.2.5",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.2",
    "webpack-bundle-analyzer": "^5.3.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
